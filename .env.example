# All settings are optional. Normal use requires no .env file.
# APIUNICON_HOME=/absolute/path/to/private-state
# APIUNICON_MASTER_KEY=optional-base64-encoded-32-byte-key-override
# APIUNICON_DB_PATH=/absolute/path/to/apiunicon.sqlite
# Only a loopback address is accepted: 127.0.0.1, ::1, or localhost.
APIUNICON_HTTP_HOST=127.0.0.1
APIUNICON_HTTP_PORT=3210
APIUNICON_MAX_RESPONSE_BYTES=1048576
APIUNICON_MAX_UPSTREAM_BYTES=16777216
APIUNICON_REQUEST_TIMEOUT_MS=15000
APIUNICON_MAX_CRAWL_PAGES=50
APIUNICON_MAX_DOCUMENT_BYTES=5242880
# Shared adapter catalog: on by default. A Russian system language (LC_ALL, LC_MESSAGES, or LANG) uses https://apiunicon.ru,
# anything else https://apiunicon.online. Set this only to name another cloud (an HTTPS origin).
# Nothing about your connections is sent before you sign in. Opening the sign-in link does register this computer with
# the cloud as a client: a client name and the local callback address. After sign-in the cloud receives the
# documentation link without its query or fragment, and the chosen entry id.
# APIUNICON_CATALOG_ORIGIN=https://apiunicon.online
