{
  "name": "apiunicon-core",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    "./*.js": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/src/db && cp src/db/schema.sql src/db/schema-v1.sql dist/src/db/",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts serve",
    "mcp": "tsx src/cli.ts mcp",
    "mcp:claude": "tsx src/cli.ts claude-mcp-add",
    "setup-link": "tsx src/cli.ts setup-link",
    "service:install": "npm run build && tsx scripts/macos-service.ts install",
    "service:status": "tsx scripts/macos-service.ts status",
    "service:uninstall": "tsx scripts/macos-service.ts uninstall"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "tldts": "7.4.16",
    "undici": "8.12.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
